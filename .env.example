# Стартовый администратор. Если не заданы — админ при старте не создаётся.
ADMIN_IIN=000000000000
ADMIN_PASSWORD=change-me
ADMIN_FULL_NAME=Администратор
ADMIN_PHONE=+77000000000

# Разрешённые origin для CORS (через запятую). Если пусто — CORS открыт без credentials.
PLACE_URL=http://localhost:5173,https://localhost:5173

# Строка подключения к БД (PostgreSQL, async-драйвер asyncpg).
# Alembic сам заменит +asyncpg на синхронный psycopg2.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/online_platform

# Пул соединений НА ОДИН воркер. Правило: workers * (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# должно укладываться в postgres max_connections (обычно 100).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Обязателен: длинный случайный секрет для подписи JWT. Без него приложение не стартует.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
